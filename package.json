{
  "name": "@aelluxjs/core",
  "version": "0.1.0-beta.6",
  "license": "Apache-2.0",
  "description": "Modular UX behavior management for browser interfaces with an ES5-compatible aellux.js boot script and an ES2017+ runtime",
  "keywords": [
    "aellux",
    "aellux.js",
    "bootstrap",
    "browser",
    "declarative",
    "extensions",
    "progressive-enhancement",
    "ux"
  ],
  "homepage": "https://aelluxjs.github.io/",
  "bugs": {
    "url": "https://github.com/aelluxjs/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelluxjs/core.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/aellux.esm.js",
      "default": "./dist/aellux.js"
    },
    "./boot": "./dist/aellux.js",
    "./esm": "./dist/aellux.esm.js",
    "./full": "./dist/aellux.full.js",
    "./full/legacy": "./dist/aellux.full.legacy.js",
    "./orchestrator": "./dist/aellux.orchestrator.js",
    "./orchestrator/legacy": "./dist/aellux.orchestrator.legacy.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "third-party/licenses"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:docs",
    "build:core": "node scripts/build-core.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "pretest:browser": "npm run build:core",
    "test:browser": "playwright test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@wolimp/docweaver": "github:wolimp-inc/docweaver#fcad3db8b8195a0c61852ce71b3129a502a79354",
    "core-js": "^3.50.0",
    "custom-event-polyfill": "^1.0.7",
    "esbuild": "^0.25.0",
    "raf": "^3.4.1",
    "whatwg-fetch": "^3.6.20"
  }
}
