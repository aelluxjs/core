{
  "name": "aellux",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Declarative, extension-based UX for browser interfaces with ES2017+ runtime syntax and an ES5-compatible bootstrap and legacy fallback path",
  "type": "module",
  "exports": {
    ".": "./dist/aellux.js",
    "./bootstrap": "./dist/aellux.js",
    "./full": "./dist/aellux.full.js",
    "./orchestrator": "./dist/aellux.orchestrator.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
