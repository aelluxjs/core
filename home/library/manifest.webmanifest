{
  "id": "./",
  "name": "AelluxJS Library — Copy, paste, customize.",
  "short_name": "ællux.js",
  "description": "Experiências responsivas para copiar, colar e personalizar, inclusive offline.",
  "lang": "pt-BR",
  "start_url": "./index.htm",
  "scope": "./",
  "display": "standalone",
  "background_color": "#232323",
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
